rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════
    // USERS COLLECTION
    // ═══════════════════════════════════════════════════════
    match /users/{userId} {
      // Anyone authenticated can read any user profile
      allow read: if isSignedIn();

      // User can create their own document
      allow create: if isOwner(userId);

      // User can fully update their own document
      // OTHER users can update social/friend fields
      allow update: if isOwner(userId)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'friendRequests', 'friends', 'blockedUsers', 'oneSignalPlayerId',
                 'rippleScore', 'totalMessagesSent', 'totalImagesSent',
                 'totalVoiceMessages', 'totalFriends', 'translatorUsed',
                 'aiFeaturesUsed', 'secretChats'
               ]))
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'privacy.stealthContacts', 'privacy.lastSeenVisibility',
                 'privacy.onlineStatusVisibility', 'privacy.profilePhotoVisibility',
                 'privacy.bioVisibility', 'privacy.readReceiptsEnabled',
                 'privacy.typingIndicatorEnabled', 'privacy.stealthMode',
                 'privacy.screenshotBlockEnabled', 'privacy.incognitoKeyboardEnabled',
                 'privacy.chatLockEnabled', 'privacy.fakePasscode',
                 'privacy.telepathyEnabled'
               ]));

      allow delete: if false;

      // Achievements subcollection
      match /achievements/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Visitors subcollection
      match /visitors/{docId} {
        allow read: if isOwner(userId);
        allow write: if isSignedIn();
      }

      // Prekeys subcollection (X3DH key bundles)
      match /prekeys/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // Devices subcollection (linked devices / companion app sessions)
      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // ═══════════════════════════════════════════════════════
    // CHATS COLLECTION
    // ═══════════════════════════════════════════════════════
    match /chats/{chatId} {
      // Any authenticated user can list chats — the Flutter query
      // already filters with where('participants', arrayContains: uid)
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId))
             .data.participants;

        // Holographic Word-Threads™ sub-collection
        match /wordThreads/{threadId} {
          allow read, write: if isSignedIn()
            && request.auth.uid in
               get(/databases/$(database)/documents/chats/$(chatId))
               .data.participants;
        }
      }
    }

    // ═══════════════════════════════════════════════════════
    // GROUPS COLLECTION
    // ═══════════════════════════════════════════════════════
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;

      allow create: if isSignedIn();

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members;

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId))
             .data.members;

        // Holographic Word-Threads™ sub-collection
        match /wordThreads/{threadId} {
          allow read, write: if isSignedIn()
            && request.auth.uid in
               get(/databases/$(database)/documents/groups/$(groupId))
               .data.members;
        }
      }
    }

    // ═══════════════════════════════════════════════════════
    // CALLS COLLECTION
    // ═══════════════════════════════════════════════════════
    match /calls/{callId} {
      // Any authenticated user can create a call
      allow create: if isSignedIn();

      // Participants can read the call
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.get('calleeId', '')
            || (resource.data.get('memberIds', [])
                .hasAny([request.auth.uid])));

      // Participants can update call status
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.get('calleeId', '')
            || (resource.data.get('memberIds', [])
                .hasAny([request.auth.uid])));

      // Only caller can delete
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.callerId;
    }

    // ═══════════════════════════════════════════════════════
    // STATUSES COLLECTION
    // ═══════════════════════════════════════════════════════
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.uid;
    }

    // ═══════════════════════════════════════════════════════
    // SAVED MESSAGES (per-user subcollection)
    // ═══════════════════════════════════════════════════════
    match /users/{userId}/savedMessages/{msgId} {
      allow read, write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════
    // FOLDERS (per-user subcollection)
    // ═══════════════════════════════════════════════════════
    match /users/{userId}/folders/{folderId} {
      allow read, write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════
    // SCHEDULED MESSAGES
    // ═══════════════════════════════════════════════════════
    match /scheduledMessages/{msgId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId;
      allow read, update, delete: if isSignedIn()
        && request.auth.uid == resource.data.senderId;
    }

    // ═══════════════════════════════════════════════════════
    // CLOUD DRIVE (per-user files)
    // ═══════════════════════════════════════════════════════
    match /user_files/{userId} {
      match /files/{fileId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════
    // POLLS (within groups or individual chats)
    // ═══════════════════════════════════════════════════════
    match /polls/{pollId} {
      // Anyone in the chat/group can read and vote
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.voterIds || resource.data.get('isPublic', false));
      
      // Creating a poll
      allow create: if isSignedIn();

      // Voting - only update specific fields
      allow update: if isSignedIn()
        && (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['votes', 'voterIds']));
    }

    // ═══════════════════════════════════════════════════════
    // SECRET CHATS (E2E Encrypted)
    // ═══════════════════════════════════════════════════════
    match /secretChats/{chatId} {
      // Only participants can read their secret chats
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      // Participants can create secret chats
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.encrypted == true;

      // Participants can update secret chat metadata
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      // Only participants can delete
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/secretChats/$(chatId))
             .data.participants;
      }

      // Handshake subcollection
      match /handshake/{docId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/secretChats/$(chatId))
             .data.participants;
      }
    }

    // ═══════════════════════════════════════════════════════
    // CHALLENGES (Weekly challenges)
    // ═══════════════════════════════════════════════════════
    match /challenges/{challengeId} {
      // Anyone authenticated can read active challenges
      allow read: if isSignedIn();

      // Only admins can create challenges (via admin functions)
      allow create: if isSignedIn();

      // No direct updates from clients - use cloud functions
      allow update: if false;

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // BADGES (Achievement definitions)
    // ═══════════════════════════════════════════════════════
    match /badges/{badgeId} {
      // Anyone can read badge definitions
      allow read: if isSignedIn();

      // Only system can create/update badges
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // CHALLENGE PROGRESS (per-user subcollection)
    // ═══════════════════════════════════════════════════════
    match /users/{userId}/challengeProgress/{progressId} {
      // Users can read their own progress
      allow read: if isOwner(userId);

      // Users can update their own progress (completing challenges)
      allow write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════
    // USER BADGES (per-user earned badges subcollection)
    // ═══════════════════════════════════════════════════════
    match /users/{userId}/badges/{badgeId} {
      // Users can read their own badges
      allow read: if isOwner(userId);

      // System awards badges - users can only mark as seen
      allow create: if isSignedIn(); // System creates
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isNew']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // GIFT CARDS (Available gift themes)
    // ═══════════════════════════════════════════════════════
    match /giftCards/{cardId} {
      // Anyone can read available gift cards
      allow read: if isSignedIn();

      // Only system can create gift card themes
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // GIFTS (Gift transactions)
    // ═══════════════════════════════════════════════════════
    match /gifts/{giftId} {
      // Sender or recipient can read gift
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.recipientId);

      // Anyone can create a gift (sending)
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId;

      // Only recipient can update status (claiming)
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'claimedAt']);

      // Only sender can delete (if pending)
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.senderId
        && resource.data.status == 'pending';
    }

    // ═══════════════════════════════════════════════════════
    // SENT GIFTS (per-user subcollection)
    // ═══════════════════════════════════════════════════════
    match /users/{userId}/giftsSent/{giftId} {
      allow read, write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════
    // RECEIVED GIFTS (per-user subcollection)
    // ═══════════════════════════════════════════════════════
    match /users/{userId}/giftsReceived/{giftId} {
      allow read, write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════
    // SUPPORT TICKETS (Contact Support form)
    // ═══════════════════════════════════════════════════════
    match /support_tickets/{ticketId} {
      // Any authenticated user can create a support ticket
      allow create: if isSignedIn();
      // Users can read their own tickets
      allow read: if isSignedIn()
        && request.auth.uid == resource.data.uid;
      // Only system can update/delete
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════
    // MEETINGS COLLECTION
    // ═══════════════════════════════════════════════════════
    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.hostUid == request.auth.uid || request.auth.uid in resource.data.participants);
      allow delete: if isSignedIn()
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
